# Optional server-only USDA key. Without a key, APIs use the bundled public
# USDA snapshot and label their provenance as snapshot, not live.
# Configure the process/deployment environment; do not prefix with VITE_.
# The local API intentionally does not auto-load private .env files.
USDA_FDC_API_KEY=

# Server-only patient invitation email. Configure in Vercel, never VITE_.
RESEND_API_KEY=<SECRET_FROM_APPROVED_STORE>
INVITATION_FROM_EMAIL=<CONFIRM_VERIFIED_SENDER>
APP_PUBLIC_URL=https://clearplate-kidney-nutrition.vercel.app
